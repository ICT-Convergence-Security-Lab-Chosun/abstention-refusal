# Source this file from the repository root, or override variables inline.
RUN_ID="${RUN_ID:-v2_paper_llama31_8b}"
MODEL_KEY="${MODEL_KEY:-llama31_8b_instruct}"
PYTHON_BIN="${PYTHON_BIN:-python3}"

# Benchmark/cue input (populated by scripts/prepare_data.py).
BENCHMARK_JSONL="${BENCHMARK_JSONL:-${DATA_DIR:-data}/squad2_umwp_falseqa_rawq_normalized.jsonl}"

# Controlled dev/test pools (00_generate_controlled_test.sh).
CONTROLLED_DEV_JSONL="${CONTROLLED_DEV_JSONL:-${DATA_DIR:-data}/controlled.valid.jsonl}"
CONTROLLED_TEST_RAW="${CONTROLLED_TEST_RAW:-runs/${RUN_ID}/controlled/controlled_test.raw.jsonl}"
CONTROLLED_TEST_JSONL="${CONTROLLED_TEST_JSONL:-runs/${RUN_ID}/controlled/controlled_test.valid.jsonl}"
CONTROLLED_TARGET_VALID_ENTITIES="${CONTROLLED_TARGET_VALID_ENTITIES:-100}"
CONTROLLED_ENTITIES_PER_CATEGORY="${CONTROLLED_ENTITIES_PER_CATEGORY:-16}"
CONTROLLED_MAX_WORKERS="${CONTROLLED_MAX_WORKERS:-8}"

DATASETS="${DATASETS:-squad2 umwp falseqa}"
BENCHMARK_DEV_N="${BENCHMARK_DEV_N:-100}"
BENCHMARK_TEST_N="${BENCHMARK_TEST_N:-100}"
CONTROLLED_DEV_ENTITIES="${CONTROLLED_DEV_ENTITIES:-100}"
CONTROLLED_TEST_ENTITIES="${CONTROLLED_TEST_ENTITIES:-100}"
CUE_LIMIT_PER_DATASET="${CUE_LIMIT_PER_DATASET:-}"
LAYERS_FULL="${LAYERS_FULL:-auto}"
LAYERS_LEAN="${LAYERS_LEAN:-auto_lean}"
LAYERS_COARSE="${LAYERS_COARSE:-auto_coarse}"
CALIB_LAYERS="${CALIB_LAYERS:-auto_calib}"
DISCOVERY_LAYERS="${DISCOVERY_LAYERS:-auto_calib}"
ALPHA_STAR_FALLBACK="${ALPHA_STAR_FALLBACK:-5}"
L_STAR_FALLBACK="${L_STAR_FALLBACK:-16}"
SAMPLE_LIMIT="${SAMPLE_LIMIT:-}"

MAX_LENGTH="${MAX_LENGTH:-2048}"
MAX_NEW_TOKENS="${MAX_NEW_TOKENS:-256}"
BATCH_SIZE="${BATCH_SIZE:-8}"
GENERATION_BATCH_SIZE="${GENERATION_BATCH_SIZE:-8}"
SEED="${SEED:-42}"

ADV_BENCH_JSONL="${ADV_BENCH_JSONL:-${DATA_DIR:-data}/advbench_harmful.jsonl}"
ALPACA_JSONL="${ALPACA_JSONL:-${DATA_DIR:-data}/alpaca_harmless.jsonl}"
REFUSAL_LIMIT="${REFUSAL_LIMIT:-200}"
E7_EVAL_N="${E7_EVAL_N:-100}"

API_BASE="${API_BASE:-https://openrouter.ai/api/v1}"
API_KEY_ENV="${API_KEY_ENV:-OPENROUTER_API_KEY}"
CONTROL_GENERATOR_MODEL="${CONTROL_GENERATOR_MODEL:-openai/gpt-4.1}"
CONTROL_VALIDATOR_MODEL="${CONTROL_VALIDATOR_MODEL:-openai/gpt-4.1-mini}"
JUDGE_MODEL="${JUDGE_MODEL:-openai/gpt-4o-mini}"

